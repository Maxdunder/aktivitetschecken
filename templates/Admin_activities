<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Godkänn aktiviteter</title>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 24px auto; padding: 0 16px; }
        .item { display: flex; gap: 16px; padding: 16px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 10px; }
        .item img { width: 100px; height: 100px; object-fit: contain; background: #f0f0f0; }
        .info { flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .actions { display: flex; flex-direction: column; gap: 8px; }
        button { padding: 8px 14px; border: 0; border-radius: 6px; cursor: pointer; color: #fff; }
        .accept { background: #1f8a4c; }
        .reject { background: #c0392b; }
    </style>
</head>
<body>
    <h1>Aktiviteter som väntar på godkännande</h1>

    {% for a in pending %}
    <div class="item">
        {% if a['image'] %}<img src="{{ a['image'] }}" alt="">{% endif %}
        <div class="info">
            <strong>{{ a['title'] }}</strong>
            <span>{{ a['category'] }}</span>
            <span>{{ a['description'] }}</span>
            <span>{{ a['date'] }} · {{ a['time'] }} · {{ a['location'] }}</span>
        </div>
        <div class="actions">
            <form method="POST" action="{{ url_for('accept_activity', activity_id=a['id']) }}">
                <button class="accept" type="submit">Godkänn</button>
            </form>
            <form method="POST" action="{{ url_for('reject_activity', activity_id=a['id']) }}">
                <button class="reject" type="submit">Neka</button>
            </form>
        </div>
    </div>
    {% else %}
    <p>Inga aktiviteter väntar på godkännande.</p>
    {% endfor %}

    <p><a href="{{ url_for('profile') }}">← Tillbaka till profilen</a></p>
</body>
</html>
